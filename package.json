{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:haeru && npm run test:stark-rift",
    "test:haeru": "node --test tests/mudflat-cast-net.test.mjs tests/mudflat-daily-challenge.test.mjs tests/mudflat-rng.test.mjs tests/mudflat-run-save.test.mjs",
    "test:stark-rift": "npm run typecheck:stark-rift && vitest run --config vitest.config.ts",
    "typecheck:stark-rift": "tsc --project tsconfig.stark-rift.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:stark-rift-lab": "vite --config tools/stark-rift-lab/vite.config.ts",
    "preview:stark-rift-lab": "vite preview --config tools/stark-rift-lab/vite.config.ts --host 127.0.0.1 --port 4175 --strictPort",
    "build:stark-rift-lab": "npm run typecheck:stark-rift && vite build --config tools/stark-rift-lab/vite.config.ts",
    "bench:stark-rift": "node tools/stark-rift-lab/benchmark.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pixi.js": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "5.0.5",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
